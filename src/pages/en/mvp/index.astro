---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import MVPHero from "@/components/MVPHero.astro";
import MVPProcess from "@/components/MVPProcess.astro";
import MVPFeatures from "@/components/MVPFeatures.astro";
import MVPPricing from "@/components/MVPPricing.astro";
import MVPFAQ from "@/components/MVPFAQ.astro";
import MVPContact from "@/components/MVPContact.astro";

import { mvpEn } from "../../../data/mvp";
---

<Layout
  title={`${mvpEn.heroTitle} - Sebastian Coronel`}
  description={mvpEn.heroSubtitle}
  lang="en"
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <MVPHero
        title={mvpEn.heroTitle}
        subtitle={mvpEn.heroSubtitle}
        calendlyUrl={mvpEn.calendlyUrl}
        bookCallLabel={mvpEn.bookCallLabel}
      />
    </SectionContainer>

    <div class="space-y-24 pb-24">
      <SectionContainer id="proceso">
        <MVPProcess title={mvpEn.processTitle} steps={mvpEn.steps} />
      </SectionContainer>

      <SectionContainer id="incluye">
        <MVPFeatures title={mvpEn.featuresTitle} features={mvpEn.features} />
      </SectionContainer>

      <SectionContainer id="precios">
        <MVPPricing title={mvpEn.pricingTitle} tiers={mvpEn.tiers} />
      </SectionContainer>

      <SectionContainer id="faq">
        <MVPFAQ title={mvpEn.faqTitle} faqs={mvpEn.faqs} />
      </SectionContainer>

      <SectionContainer id="contact">
        <MVPContact
          title={mvpEn.ctaTitle}
          subtitle={mvpEn.ctaSubtitle}
          calendlyUrl={mvpEn.calendlyUrl}
          bookCallLabel={mvpEn.bookCallLabel}
        />
      </SectionContainer>
    </div>
  </main>
</Layout>