---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import MVPHero from "@/components/MVPHero.astro";
import MVPProcess from "@/components/MVPProcess.astro";
import MVPFeatures from "@/components/MVPFeatures.astro";
import MVPPricing from "@/components/MVPPricing.astro";
import MVPFAQ from "@/components/MVPFAQ.astro";
import MVPContact from "@/components/MVPContact.astro";

import { mvpEs } from "../../data/mvp";
---

<Layout
  title={`${mvpEs.heroTitle} - Sebastian Coronel`}
  description={mvpEs.heroSubtitle}
  lang="es"
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <MVPHero
        title={mvpEs.heroTitle}
        subtitle={mvpEs.heroSubtitle}
        calendlyUrl={mvpEs.calendlyUrl}
        bookCallLabel={mvpEs.bookCallLabel}
      />
    </SectionContainer>

    <div class="space-y-24 pb-24">
      <SectionContainer id="proceso">
        <MVPProcess title={mvpEs.processTitle} steps={mvpEs.steps} />
      </SectionContainer>

      <SectionContainer id="incluye">
        <MVPFeatures title={mvpEs.featuresTitle} features={mvpEs.features} />
      </SectionContainer>

      <SectionContainer id="precios">
        <MVPPricing title={mvpEs.pricingTitle} tiers={mvpEs.tiers} />
      </SectionContainer>

      <SectionContainer id="faq">
        <MVPFAQ title={mvpEs.faqTitle} faqs={mvpEs.faqs} />
      </SectionContainer>

      <SectionContainer id="contacto">
        <MVPContact
          title={mvpEs.ctaTitle}
          subtitle={mvpEs.ctaSubtitle}
          calendlyUrl={mvpEs.calendlyUrl}
          bookCallLabel={mvpEs.bookCallLabel}
        />
      </SectionContainer>
    </div>
  </main>
</Layout>