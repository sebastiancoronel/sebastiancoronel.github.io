---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import AboutMe from "@/components/AboutMe.astro";
import Experience from "@/components/Experience.astro";
import Skills from "@/components/Skills.astro";
import Education from "@/components/Education.astro";
import MVPCallToAction from "@/components/MVPCallToAction.astro";
import Portfolio from "@/components/Portfolio.astro";

import Briefcase from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import BookIcon from "@/components/icons/Book.astro";

import { cvEs } from "../data/cv";
import { projectsEs } from "../data/projects";
---

<Layout
  title={`${cvEs.name} - ${cvEs.title}`}
  description={`Curriculum Vitae de ${cvEs.name} - ${cvEs.title}`}
  lang="es"
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero
        name={cvEs.name}
        title={cvEs.title}
        address={cvEs.address}
        contacts={cvEs.contacts}
        availableLabel={cvEs.labels.availableForWork}
      />
    </SectionContainer>

    <div class="space-y-24 pb-24">
      <SectionContainer id="sobre-mi">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <ProfileCheck class="size-8" />
          {cvEs.labels.aboutMe}
        </h2>
        <AboutMe text={cvEs.aboutMe} />
      </SectionContainer>

      <SectionContainer id="experiencia">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Briefcase class="size-8" />
          {cvEs.labels.experience}
        </h2>
        <Experience experience={cvEs.experience} />
      </SectionContainer>

      <SectionContainer id="skills">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <CodeIcon class="size-7" />
          {cvEs.labels.skills}
        </h2>
        <Skills skills={cvEs.skills} />
      </SectionContainer>

      <SectionContainer id="educacion">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <BookIcon class="size-8" />
          {cvEs.labels.education}
        </h2>
        <Education education={cvEs.education} />
      </SectionContainer>

      <!-- <SectionContainer>
        <MVPCallToAction
          title="Construyo tu MVP en 3 semanas"
          subtitle="Transformo tu idea en un producto funcional listo para validar en el mercado"
          ctaLabel="Ver más"
          href="/mvp"
        />
      </SectionContainer> -->

      <SectionContainer id="portfolio">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <CodeIcon class="size-7" />
          Portfolio
        </h2>
        <Portfolio projects={projectsEs} lang="es" />
      </SectionContainer>
    </div>
  </main>
</Layout>
