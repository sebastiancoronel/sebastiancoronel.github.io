---
import type { MVPFeature } from "../data/mvp";

interface Props {
  title: string;
  features: MVPFeature[];
}

const { title, features } = Astro.props;
---

<div class="w-full">
  <h2
    class="flex items-center justify-center mb-12 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
  >
    {title}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      features.map((feature) => (
        <div
          class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/30 backdrop-blur-sm transition-all duration-300 hover:shadow-md hover:border-zinc-300 dark:hover:border-zinc-700/80"
        >
          <h3 class="text-lg font-bold text-yellow-500 dark:text-yellow-400 mb-4">
            {feature.title}
          </h3>
          <ul class="space-y-2">
            {
              feature.items.map((item) => (
                <li class="flex items-start gap-x-2 text-sm text-zinc-600 dark:text-zinc-300">
                  <svg
                    class="size-4 mt-0.5 text-yellow-500 dark:text-yellow-400 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</div>