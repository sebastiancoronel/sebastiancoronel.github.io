---
import type { MVPFAQ as MVPFAQType } from "../data/mvp";

interface Props {
  title: string;
  faqs: MVPFAQType[];
}

const { title, faqs } = Astro.props;
---

<div class="w-full max-w-3xl mx-auto">
  <h2
    class="flex items-center justify-center mb-12 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
  >
    {title}
  </h2>
  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details class="group rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/30 backdrop-blur-sm transition-all duration-300 hover:border-zinc-300 dark:hover:border-zinc-700/80 overflow-hidden">
          <summary class="flex items-center justify-between gap-x-2 px-6 py-4 cursor-pointer text-base font-semibold text-zinc-800 dark:text-zinc-200 hover:text-yellow-500 dark:hover:text-yellow-400 transition-colors select-none list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 transition-transform duration-200 group-open:rotate-180 text-zinc-500 dark:text-zinc-400 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-4 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))
    }
  </div>
</div>