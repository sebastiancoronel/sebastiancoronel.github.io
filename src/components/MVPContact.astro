---
interface Props {
  title: string;
  subtitle: string;
  calendlyUrl: string;
  bookCallLabel: string;
}

const { title, subtitle, calendlyUrl } = Astro.props;
---

<div class="flex flex-col items-center text-center gap-6 w-full">
  <h2
    class="text-3xl font-semibold text-black/80 dark:text-white"
  >
    {title}
  </h2>
  <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-xl leading-relaxed">
    {subtitle}
  </p>
  <div
    class="w-full max-w-lg p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/30 backdrop-blur-sm"
  >
    <div
      class="calendly-inline-widget min-h-[600px] w-full"
      data-url={calendlyUrl}
      style="min-width: 320px; min-height: 600px;"
    ></div>
    <script is:inline async src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript"></script>
  </div>
</div>