---
import type { MVPPricingTier } from "../data/mvp";

interface Props {
  title: string;
  tiers: MVPPricingTier[];
}

const { title, tiers } = Astro.props;
---

<div class="w-full">
  <h2
    class="flex items-center justify-center mb-12 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
  >
    {title}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
    {
      tiers.map((tier) => (
        <div
          class={`relative flex flex-col p-6 rounded-2xl border backdrop-blur-sm transition-all duration-300 hover:shadow-md ${
            tier.popular
              ? "border-yellow-500/50 dark:border-yellow-500/40 bg-yellow-50/40 dark:bg-yellow-950/20 shadow-lg"
              : "border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/30"
          }`}
        >
          {
            tier.popular && (
              <span
                class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 text-xs font-bold text-white bg-yellow-500 rounded-full"
              >
                Most popular
              </span>
            )
          }
          <h3 class="text-xl font-bold text-zinc-800 dark:text-zinc-200 mb-1">
            {tier.name}
          </h3>
          <p class="text-3xl font-bold text-yellow-500 dark:text-yellow-400 mb-1">
            {tier.price}
          </p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-6">
            {tier.features} features
          </p>
          <ul class="space-y-3 mb-8">
            {
              tier.bullets.map((bullet) => (
                <li class="flex items-start gap-x-2 text-sm text-zinc-600 dark:text-zinc-300">
                  <svg
                    class="size-4 mt-0.5 text-yellow-500 dark:text-yellow-400 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</div>